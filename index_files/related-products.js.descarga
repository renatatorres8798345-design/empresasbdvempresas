(function (Drupal, once) {

  /**
   * Related Product Carousel Behavior
   * Provides carousel functionality with navigation dots for related products
   */
  Drupal.behaviors.relatedProductCarousel = {
    attach: function (context) {
      // Use 'once' to ensure the behavior is applied only once per element
      once('related-products-carousel', '.related-products__carousel', context).forEach((carousel) => {
        const container = carousel.querySelector('[data-carousel-container]');
        const dots = carousel.querySelectorAll('.related__nav-dot');
        let currentSlide = 0;

        // Exit if required elements are not found
        if (!container || dots.length === 0) {
          return;
        }

        /**
         * Navigate to specific slide
         * @param {number} slideIndex - Index of slide to navigate to
         */
        function goToSlide(slideIndex) {
          // Validate slide index
          if (slideIndex < 0 || slideIndex >= dots.length) {
            return;
          }

          // Remove active class from all dots
          dots.forEach(dot => dot.classList.remove('active'));

          // Add active class to current dot
          dots[slideIndex].classList.add('active');

          // Calculate transform value for slide transition
          const translateX = slideIndex * -100;
          container.style.transform = `translateX(${translateX}%)`;

          currentSlide = slideIndex;

          // Announce slide change to screen readers
          const announcement = `Artículo ${slideIndex + 1} de ${dots.length}`;
          announceToScreenReader(announcement);
        }

        /**
         * Announce changes to screen readers
         * @param {string} message - Message to announce
         */
        function announceToScreenReader(message) {
          const announcement = document.createElement('div');
          announcement.setAttribute('aria-live', 'polite');
          announcement.setAttribute('aria-atomic', 'true');
          announcement.className = 'sr-only';
          announcement.textContent = message;

          document.body.appendChild(announcement);

          // Remove announcement after it's been read
          setTimeout(() => {
            document.body.removeChild(announcement);
          }, 1000);
        }

        // Add click event listeners to navigation dots
        dots.forEach((dot, index) => {
          dot.addEventListener('click', (event) => {
            event.preventDefault();
            goToSlide(index);
          });
        });

        // Add keyboard navigation support
        carousel.addEventListener('keydown', (event) => {
          switch (event.key) {
            case 'ArrowLeft':
              event.preventDefault();
              if (currentSlide > 0) {
                goToSlide(currentSlide - 1);
              }
              break;
            case 'ArrowRight':
              event.preventDefault();
              if (currentSlide < dots.length - 1) {
                goToSlide(currentSlide + 1);
              }
              break;
            case 'Home':
              event.preventDefault();
              goToSlide(0);
              break;
            case 'End':
              event.preventDefault();
              goToSlide(dots.length - 1);
              break;
          }
        });

        // Make carousel focusable for keyboard navigation
        carousel.setAttribute('tabindex', '0');
        carousel.setAttribute('role', 'region');
        carousel.setAttribute('aria-label', 'Carrusel de artículos relacionados');

        // Add swipe support for touch devices
        let startX = 0;
        let startY = 0;
        let distX = 0;
        let distY = 0;
        const threshold = 50; // Minimum swipe distance

        container.addEventListener('touchstart', (event) => {
          const touch = event.touches[0];
          startX = touch.clientX;
          startY = touch.clientY;
        }, { passive: true });

        container.addEventListener('touchmove', (event) => {
          if (!startX || !startY) return;

          const touch = event.touches[0];
          distX = touch.clientX - startX;
          distY = touch.clientY - startY;
        }, { passive: true });

        container.addEventListener('touchend', () => {
          if (Math.abs(distX) > Math.abs(distY) && Math.abs(distX) > threshold) {
            if (distX > 0 && currentSlide > 0) {
              // Swipe right - go to previous slide
              goToSlide(currentSlide - 1);
            } else if (distX < 0 && currentSlide < dots.length - 1) {
              // Swipe left - go to next slide
              goToSlide(currentSlide + 1);
            }
          }

          // Reset values
          startX = 0;
          startY = 0;
          distX = 0;
          distY = 0;
        }, { passive: true });
      });
    }
  };
})(Drupal, once);
